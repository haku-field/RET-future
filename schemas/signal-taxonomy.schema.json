{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "ret-future.signal-taxonomy",
  "title": "RET-future Signal Taxonomy",
  "type": "object",
  "description": "Schema for non-semantic, non-agentive signal taxonomy definitions.",
  "additionalProperties": false,

  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "properties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "disallowed_inference": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "description"]
      }
    }
  },

  "required": [
    "id",
    "primitives"
  ]
}