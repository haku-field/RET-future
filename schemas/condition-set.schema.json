{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "ret-future.condition-set",
  "title": "RET-future Condition Set",
  "type": "object",
  "description": "Schema for non-authoritative condition sets used in RET-future.",
  "additionalProperties": false,

  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the condition set."
    },
    "category": {
      "type": "string",
      "enum": [
        "assumption",
        "unknown",
        "constraint",
        "necessity",
        "sufficiency",
        "failure_mode"
      ]
    },
    "statement": {
      "type": "string",
      "description": "Literal description of the condition."
    },
    "scope": {
      "type": "string",
      "description": "Evaluation scope affected by this condition."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit dependencies, if any."
    },
    "notes": {
      "type": "string",
      "description": "Optional clarifying notes without justification."
    }
  },

  "required": [
    "id",
    "category",
    "statement"
  ]
}